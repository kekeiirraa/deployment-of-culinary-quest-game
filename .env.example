# copy to .env and fill in your own values
# .env is git ignored - never commit real secrets

# postgres connection string from neon (use the POOLED one)
# neon console > your project > connection details > pooled connection
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# jwt settings for login sessions
# generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# port the server listens on (render sets this automatically in production)
PORT=3000
